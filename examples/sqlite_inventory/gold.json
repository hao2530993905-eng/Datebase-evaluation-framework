      "steps": [
        {
          "sql": "SELECT name FROM sqlite_master WHERE type = 'table' AND name IN ('categories', 'products', 'orders', 'order_items') ORDER BY name",
          "expect": {
            "kind": "rows_equal",
            "value": [
              [
                "categories"
              ],
              [
                "order_items"
              ],
              [
                "orders"
              ],
              [
                "products"
              ]
            ]
          }
        }
      ],
      "provenance": {
        "source_ids": [
          "file:acceptance.md",
          "file:schema.sql"
        ],
        "rationale": "验收依据明确列出四类业务实体，Schema 文件提供结构基线。",
        "validation_status": "verified"
      }
    },
