      "expect": {
        "kind": "scalar",
        "value": 0
      },
      "workers": 5,
      "iterations": 4,
      "tolerated_errors": 0,
      "provenance": {
        "source_ids": [
          "file:acceptance.md#concurrency",
          "rule:no-negative-stock"
        ],
