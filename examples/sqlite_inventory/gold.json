    {
      "id": "DB2.query.order_aggregate",
      "dimension": "DB2",
      "indicator": "DB2.2",
      "title": "订单明细聚合正确",
      "type": "sql",
      "weight": 1.0,
      "steps": [
        {
          "sql": "SELECT o.id, o.status, COUNT(oi.id), SUM(oi.qty * oi.unit_price_cents) FROM orders o JOIN order_items oi ON oi.order_id = o.id GROUP BY o.id, o.status ORDER BY o.id",
          "expect": {
            "kind": "rows_equal",
            "value": [
              [
                1001,
                "pending",
                2,
                6298
              ],
              [
                1002,
                "paid",
                1,
                19999
              ]
            ]
          }
        }
      ],
      "provenance": {
        "source_ids": [
          "file:acceptance.md",
          "file:seed.sql"
        ],
        "rationale": "Seed 是冻结的测试初始状态；订单聚合期望可由输入数据独立算出。",
        "validation_status": "verified"
      }
    },
    {
      "id": "DB2.query.pagination",
      "dimension": "DB2",
      "indicator": "DB2.2",
      "title": "商品价格排序和分页稳定",
      "type": "sql",
      "weight": 1.0,
      "steps": [
        {
          "sql": "SELECT sku, name FROM products ORDER BY price_cents DESC, sku ASC LIMIT 2 OFFSET 1",
          "expect": {
            "kind": "rows_equal",
            "value": [
              [
                "KB-100",
                "Mechanical Keyboard"
              ],
              [
                "BK-200",
                "Database Systems"
              ]
            ]
          }
        }
      ],
      "provenance": {
        "source_ids": [
          "file:acceptance.md",
          "file:seed.sql"
        ],
        "rationale": "排序规则来自验收依据，期望顺序由初始价格数据计算，不读取当前分页输出。",
        "validation_status": "verified"
      }
    },
