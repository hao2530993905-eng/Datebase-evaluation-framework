    {
      "id": "DB3.transaction.rollback",
      "dimension": "DB3",
      "indicator": "DB3.1",
      "title": "库存更新回滚后恢复原值",
      "type": "sql",
      "weight": 1.0,
      "steps": [
        {
          "sql": "BEGIN",
          "expect": {
            "kind": "success",
            "value": true
          }
        },
        {
          "sql": "UPDATE products SET stock_units = 99 WHERE id = 1",
          "expect": {
            "kind": "affected_rows",
            "value": 1
          }
        },
        {
          "sql": "ROLLBACK",
          "expect": {
            "kind": "success",
            "value": true
          }
        },
        {
          "sql": "SELECT stock_units FROM products WHERE id = 1",
          "expect": {
            "kind": "scalar",
            "value": 10
          }
        }
      ],
      "provenance": {
        "source_ids": [
          "file:acceptance.md#transactions",
          "rule:rollback-atomicity"
        ],
        "rationale": "回滚必须撤销事务内更新，初始库存由 Seed 明确定义为 10。",
        "validation_status": "verified"
      }
    },
    {
      "id": "DB3.transaction.failed_statement_cleanup",
      "dimension": "DB3",
      "indicator": "DB3.1",
      "title": "失败写入后显式回滚清除整组操作",
      "type": "sql",
      "weight": 1.0,
      "steps": [
        {
          "sql": "BEGIN",
          "expect": {
            "kind": "success",
            "value": true
          }
        },
        {
          "sql": "INSERT INTO categories(id, name) VALUES (99, 'temporary')",
          "expect": {
            "kind": "affected_rows",
            "value": 1
          }
        },
        {
          "sql": "INSERT INTO products(id, sku, category_id, name, price_cents, stock_units) VALUES (52, 'ATOMIC-FAIL', 99, 'Atomic failure', 100, -1)",
          "expect": {
            "kind": "error_contains",
            "value": "CHECK constraint failed"
          }
        },
        {
          "sql": "ROLLBACK",
          "expect": {
            "kind": "success",
            "value": true
          }
        },
        {
          "sql": "SELECT COUNT(*) FROM categories WHERE id = 99",
          "expect": {
            "kind": "scalar",
            "value": 0
          }
        }
      ],
      "provenance": {
        "source_ids": [
          "rule:atomicity",
          "file:schema.sql#products"
        ],
        "rationale": "显式事务包含一条有效和一条失败写入，回滚后整个事务必须不可见。",
        "validation_status": "verified"
      }
    },
    {
      "id": "DB3.transaction.commit",
      "dimension": "DB3",
      "indicator": "DB3.1",
