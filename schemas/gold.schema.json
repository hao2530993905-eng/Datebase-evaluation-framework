{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dbeval/gold.schema.json",
  "title": "DBEval Frozen Gold Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "software",
    "created_at",
    "created_by",
    "dimension_weights",
    "cases",
    "evidence_manifest",
    "freeze"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "software": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string"},
    "created_by": {"type": "string"},
    "dimension_weights": {"$ref": "#/$defs/dimensionWeights"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "evidence_manifest": {
      "type": "object",
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "files": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      },
      "additionalProperties": false
    },
    "freeze": {
      "type": "object",
      "required": ["status", "content_hash", "approved_by", "approved_at"],
      "properties": {
        "status": {"const": "frozen"},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string"},
        "signature_algorithm": {"enum": ["none", "hmac-sha256"]},
        "signature": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "generation": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "dimensionWeights": {
      "type": "object",
      "required": ["DB1", "DB2", "DB3", "DB4", "DB5", "DB6", "DB7", "DB8"],
      "additionalProperties": false,
      "properties": {
        "DB1": {"type": "number", "minimum": 0},
        "DB2": {"type": "number", "minimum": 0},
        "DB3": {"type": "number", "minimum": 0},
        "DB4": {"type": "number", "minimum": 0},
        "DB5": {"type": "number", "minimum": 0},
        "DB6": {"type": "number", "minimum": 0},
        "DB7": {"type": "number", "minimum": 0},
        "DB8": {"type": "number", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_ids", "rationale", "validation_status"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["candidate", "verified", "frozen"]},
        "verified_by": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "expectation": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "success",
            "query_success",
            "error_contains",
            "any_error",
            "affected_rows",
            "row_count",
            "scalar",
            "rows_equal",
            "rows_equal_unordered",
            "contains_rows",
            "json_path",
            "not_success",
            "health_pass",
            "no_findings",
            "exit_code",
            "junit"
          ]
        },
        "value": {},
        "path": {"type": "string"},
        "min_severity": {"enum": ["info", "low", "medium", "high", "critical"]}
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["sql"],
      "properties": {
        "sql": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "expect": {"$ref": "#/$defs/expectation"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "indicator",
        "title",
        "type",
        "provenance"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["DB1", "DB2", "DB3", "DB4", "DB5", "DB6", "DB7", "DB8"]},
        "indicator": {
          "enum": [
            "DB1.1", "DB1.2", "DB1.3",
            "DB2.1", "DB2.2", "DB2.3",
            "DB3.1", "DB3.2", "DB3.3",
            "DB4.1", "DB4.2", "DB4.3",
            "DB5.1", "DB5.2", "DB5.3",
            "DB6.1", "DB6.2", "DB6.3",
            "DB7.1", "DB7.2", "DB7.3",
            "DB8.1", "DB8.2", "DB8.3"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["sql", "benchmark", "health", "backup_restore", "concurrency", "command"]},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "required": {"type": "boolean"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "setup": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "requires_capabilities": {"type": "array", "items": {"type": "string"}},
        "requires_features": {"type": "array", "items": {"type": "string"}},
        "applies_if": {
          "type": "object",
          "required": ["feature"],
          "properties": {
            "feature": {"type": "string"},
            "equals": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "skip_reason": {"type": "string"},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
              "title": {"type": "string"}
            }
          }
        },
        "scoring": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["pass_fail", "ramp"]},
            "metric": {"type": "string"},
            "direction": {"enum": ["lower_is_better", "higher_is_better"]},
            "target": {"type": "number"},
            "floor": {"type": "number"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "sql"}}},
          "then": {"required": ["steps"]}
        },
        {
          "if": {"properties": {"type": {"const": "benchmark"}}},
          "then": {"required": ["sql", "repeat", "scoring"]}
        },
        {
          "if": {"properties": {"type": {"const": "health"}}},
          "then": {"required": ["check", "expect"]}
        },
        {
          "if": {"properties": {"type": {"const": "backup_restore"}}},
          "then": {"required": ["verification_sql", "expect"]}
        },
        {
          "if": {"properties": {"type": {"const": "concurrency"}}},
          "then": {
            "required": [
              "worker_sql",
              "workers",
              "iterations",
              "verification_sql",
              "expect"
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "command"}}},
          "then": {"required": ["command", "expect"]}
        }
      ]
    }
  }
}
